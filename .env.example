# ==========================================
# Movie Intel - Environment Configuration
# ==========================================

# [1] Gemini API Key (Recommended)
# Used for live LLM Scene Context Summarization (enricher.py) and RAG answer synthesis (rag_engine.py).
# If omitted, the system gracefully falls back to persistent cached summaries and structured RAG synthesis.
GEMINI_API_KEY=your_gemini_api_key_here

# [2] HuggingFace Hub Token (Optional)
# Suppresses rate limit warnings when downloading SentenceTransformer embeddings ("all-MiniLM-L6-v2").
# HF_TOKEN=your_huggingface_token_here
